---
/**
 * [INPUT]: 双语 MDX 提供图像与语义；共享 ui-kit.css 提供截图表面的高度 token。
 * [OUTPUT]: 可打开原图的响应式图像，以及窄屏时可用键盘滚动的图面。
 * [POS]: 双语图解导读共用的静态图像组件，继承 Starlight 的配色与焦点样式。
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
  displayWidth?: number;
  kind?: 'diagram' | 'screenshot';
  lang?: 'en' | 'zh';
}

const { src, alt, caption, width, height, displayWidth, kind = 'diagram', lang = 'en' } = Astro.props;
const openLabel = lang === 'zh' ? '打开原图' : 'Open full-size image';
const scrollLabel = lang === 'zh' ? '图像区域，可横向滚动' : 'Image area, scroll horizontally';
const frameWidth = displayWidth ?? (kind === 'diagram' ? width : width / 2);
const minWidth = Math.min(frameWidth, 600);
---
<figure class:list={['doc-figure', kind]} style={`--figure-width: ${frameWidth}px; --figure-min-width: ${minWidth}px`}>
  <div class="image-frame" role="group" aria-label={scrollLabel} tabindex="0">
    <a class="image-link" href={src} aria-label={`${openLabel} · ${alt}`}>
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    </a>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .doc-figure {
    width: 100%;
    max-width: var(--figure-width);
    margin-inline: 0;
  }

  .image-frame {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--geist-radius);
  }

  .screenshot .image-frame {
    border-radius: 12px;
    box-shadow: var(--cb-floating);
  }

  .image-frame:focus-visible,
  .image-link:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  .image-link {
    display: block;
    min-width: var(--figure-min-width);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    padding-block: 0.5rem 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }



</style>
