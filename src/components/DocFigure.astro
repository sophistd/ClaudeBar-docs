---
/**
 * [INPUT]: 双语 MDX 提供图像路径、原始尺寸、替代文字和图注。
 * [OUTPUT]: 可打开原图的响应式图像，以及窄屏时可用键盘滚动的图面。
 * [POS]: 双语图解导读共用的静态图像组件，继承 Starlight 的配色与焦点样式。
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
interface Props {
  src: string;
  alt: string;
  caption: string;
  width: number;
  height: number;
  displayWidth?: number;
  kind?: 'diagram' | 'screenshot';
  lang?: 'en' | 'zh';
}

const { src, alt, caption, width, height, displayWidth, kind = 'diagram', lang = 'en' } = Astro.props;
const openLabel = lang === 'zh' ? '打开原图' : 'Open full-size image';
const scrollLabel = lang === 'zh' ? '图像区域，可横向滚动' : 'Image area, scroll horizontally';
const frameWidth = displayWidth ?? (kind === 'diagram' ? width : width / 2);
const minWidth = Math.min(frameWidth, 600);
---
<figure class="doc-figure" style={`--figure-width: ${frameWidth}px; --figure-min-width: ${minWidth}px`}>
  <div class="image-frame" role="group" aria-label={scrollLabel} tabindex="0">
    <a class="image-link" href={src} aria-label={`${openLabel} · ${alt}`}>
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    </a>
  </div>
  <figcaption>
    {minWidth >= 600 && <span class="scroll-hint">{lang === 'zh' ? '左右滑动看全图，或打开原图。' : 'Swipe across the image, or open it full size.'}</span>}
    <span>{caption}</span>
    <a href={src} aria-label={`${openLabel} · ${alt}`}>{openLabel}</a>
  </figcaption>
</figure>

<style>
  .doc-figure {
    width: 100%;
    max-width: var(--figure-width);
    margin-inline: 0;
  }

  .image-frame {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  .image-frame:focus-visible,
  .image-link:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  .image-link {
    display: block;
    min-width: var(--figure-min-width);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    padding-block: 0.5rem 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  figcaption a {
    white-space: nowrap;
  }

  .scroll-hint { display: none; }
  @media (max-width: 40rem) {
    .scroll-hint { display: block; flex-basis: 100%; }
  }
</style>
