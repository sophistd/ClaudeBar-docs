---
/**
 * [INPUT]: Starlight 当前路由与文档 frontmatter。
 * [OUTPUT]: 面包屑、标题、任务契约与同源 Markdown 入口。
 * [POS]: 统一页面入口，保持阅读者与 Agent 使用同一内容源。
 * [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const section = entry.id.includes('/') ? entry.id.split('/')[0] : 'Overview';
const sectionNames: Record<string, string> = { start: 'Get started', concepts: 'Concepts', guides: 'Guides', reference: 'Reference', developers: 'Developers', project: 'Project' };
---
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href={`${base}/`}>Docs</a><span aria-hidden="true">/</span>
  <span>{sectionNames[section] ?? section}</span>
</nav>
<Default {...Astro.props} />
<p class="page-description">{data.description}</p>
{data.kind && <>
<div class="page-meta"><span>{data.kind}</span><span>{data.audience}</span><span>{data.evidence}</span></div>
<details class="page-contract">
  <summary>Before you begin &amp; page details</summary>
  <p><strong>Prerequisites:</strong> {data.prerequisites}</p>
  <p><strong>Outcome:</strong> {data.outcome}</p>
  <p>Documentation baseline: November 17, 2026. <a href={`${base}/markdown/${entry.id || 'index'}.md`}>Read as Markdown</a></p>
</details>
</>}
