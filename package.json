{
  "name": "claudebar-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node designs/assemble.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test tests/*.test.mjs",
    "test:links": "node scripts/check-site.mjs",
    "test:browser": "playwright test",
    "manifest": "node scripts/publication.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:links",
    "ci": "npm run verify && npm run test:browser && npm run designs:test",
    "designs:build": "node designs/build.mjs",
    "designs:preview": "node designs/serve.mjs",
    "designs:test": "playwright test --config designs/playwright.config.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.65.1",
    "cheerio": "^1.1.0",
    "esbuild": "0.28.2",
    "three": "0.187.0",
    "typescript": "^5.9.3"
  }
}
